---
import ExperienceCard from '../components/cards/ExperienceCard.astro';
import StackCard from '../components/cards/StackCard.astro';
import Construction from '../components/Construction.astro';
import Background from '../components/Background.astro';
import StackBubbleCard from '../components/cards/StackBubbleCard.astro';
import Welcome from '../components/Welcome.astro';
import Layout from '../layouts/Layout.astro';

import '../styles/global.css';
import ProjectCard from '../components/cards/ProjectCard.astro';
import LanguageCard from '../components/cards/LanguageCard.astro';
---

<Layout>
	<Background />
	<Welcome />
	<section id="experience" class="main__section">
		<h2>Experiencia</h2>
		<p>Actualmente trabajando en proyectos personales y un proyecto interno de la Universidad Politécnica de Madrid</p>
		<div class="experience__content">
			<div class="experience__timeline"></div>
			<ExperienceCard 
				title="Universidad Politécnica de Madrid"
				init="2025"
				end="Ahora">
				Desarrollo de una plataforma de entrega, comprobación y calificación de código para los estudiantes y profesores.
				
				<StackCard>
					<StackBubbleCard src="/assets/logos/elixir.svg">Elixir</StackBubbleCard>
					<StackBubbleCard src="/assets/logos/erlang.svg">Erlang</StackBubbleCard>
					<StackBubbleCard src="/assets/logos/phoenix.svg">Phoenix</StackBubbleCard>
					<StackBubbleCard src="/assets/logos/docker.svg">Docker</StackBubbleCard>
				</StackCard>
			</ExperienceCard>
			<ExperienceCard 
				title="Koalición Norte"
				init="2024"
				end="Ahora">
				Monitor en grupo de tiempo libre en campamentos de verano para niños y adolescentes en campo abierto.
			</ExperienceCard>
		</div>
	</section>
	<section id="Languages" class="main__section">
		<h2>Idiomas</h2>
		<div class="languages__list">
			<LanguageCard 
				language="Inglés"
				level={5}
				src="/assets/logos/uk-flag.png"
			/>
			<LanguageCard 
				language="Francés"
				level={4}
				sublevel={7}
				src="/assets/logos/french-flag.png"
			/>
			<div class="languages__legend">
				<b>Leyenda:</b>
				<div class="legend__indicator">
					<div class="legend__dot" style="background-color: var(--orange);"></div>
					<span>Nivel con certificado</span>
				</div>
				<div class="legend__indicator">
					<div class="legend__dot" style="background-color: var(--dark-orange);"></div>
					<span>Nivel real</span>
				</div>
			</div>
		</div>
	</section>
	<section id="stack" class="main__section">
		<h2>Stack</h2>
		<section class="stack__section stack__languages" >
			<h3>Lenguajes</h3>
			<div class="stack__list">
				<StackBubbleCard src="/assets/logos/html5.svg">HTML 5</StackBubbleCard>
				<StackBubbleCard src="/assets/logos/css3.svg">CSS 3</StackBubbleCard>
				<StackBubbleCard src="/assets/logos/javascript.svg">JavaScript</StackBubbleCard>
				<StackBubbleCard src="/assets/logos/typescript.svg">TypeScript</StackBubbleCard>
				<StackBubbleCard src="/assets/logos/go.svg">Go</StackBubbleCard>
				<StackBubbleCard src="/assets/logos/sql.svg">SQL</StackBubbleCard>
			</div>
		</section>
		<section class="stack__section stack__frameworks" >
			<h3>Frameworks y librerías</h3>
			<div class="stack__list">
				<StackBubbleCard src="/assets/logos/nodejs.svg">Node.js</StackBubbleCard>
				<StackBubbleCard src="/assets/logos/react.svg">React</StackBubbleCard>
				<StackBubbleCard src="/assets/logos/astro.svg">Astro</StackBubbleCard>
				<StackBubbleCard src="/assets/logos/nextjs.svg">Next.js</StackBubbleCard>
				<StackBubbleCard src="/assets/logos/tailwind.svg">Tailwind</StackBubbleCard>
			</div>
		</section>
		<section class="stack__section stack__cloud__db" >
			<h3>Cloud y Bases de datos</h3>
			<div class="stack__list">
				<StackBubbleCard src="/assets/logos/aws.svg">AWS</StackBubbleCard>
				<StackBubbleCard src="/assets/logos/hetzner.svg">Hetzner</StackBubbleCard>
				<StackBubbleCard src="/assets/logos/postgresql.svg">PostgreSQL</StackBubbleCard>
				<StackBubbleCard src="/assets/logos/prisma.svg">Prisma</StackBubbleCard>
			</div>
		</section>
		<section class="stack__section stack__devops_tools" >
			<h3>DevOps y Herramientas</h3>
			<div class="stack__list">
				<StackBubbleCard src="/assets/logos/git.svg">Git</StackBubbleCard>
				<StackBubbleCard src="/assets/logos/github.svg">GitHub</StackBubbleCard>
				<StackBubbleCard src="/assets/logos/docker.svg">Docker</StackBubbleCard>
				<StackBubbleCard src="/assets/logos/linux.svg">Linux</StackBubbleCard>
				<StackBubbleCard src="/assets/logos/copilot.svg">Github copilot</StackBubbleCard>
				<StackBubbleCard src="/assets/logos/figma.svg">Figma</StackBubbleCard>
				<StackBubbleCard src="/assets/logos/postman.svg">Postman</StackBubbleCard>
				<StackBubbleCard src="/assets/logos/clickup.svg">Clickup</StackBubbleCard>
				<StackBubbleCard src="/assets/logos/notion.svg">Notion</StackBubbleCard>
			</div>
		</section>
	</section>
	<section id="projects" class="main__section">
		<h2>Proyectos</h2>
		<div class="projects__container">
			<ProjectCard 
				title="Portfolio Personal"
				img="/assets/projects/portfolio.png"
				url="https://github.com/ellukitas-123/portfolio"
			>
				Mi portfolio personal, construido con Astro y Tailwind CSS. Presenta mi experiencia, stack tecnológico y proyectos.
				Es la página web que se muestra en este momento.
				<StackCard>
					<StackBubbleCard src="/assets/logos/astro.svg">Astro</StackBubbleCard>
					<StackBubbleCard src="/assets/logos/typescript.svg">TypeScript</StackBubbleCard>
					<StackBubbleCard src="/assets/logos/javascript.svg">JavaScript</StackBubbleCard>
				</StackCard>
			</ProjectCard>
		</div>
	</section>
</Layout>

<style>
	.main__section {
		padding: 32px 64px;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
	}

	.main__section h2,
	.main__section h3,
	.main__section p {
		text-align: center;
	}

	h2 {
		font-size: 32px;
	}

	.experience__content {
		max-width: 1100px;
		margin-top: 32px;
		position: relative;
	}

	.experience__timeline {
		position: absolute;
		left: 50%;
		width: 4px;
		top: 0;
		height: 0;
		background-color: var(--bg-2);
		border-radius: 2px;
		z-index: 0;
	}

	.experience__timeline::before,
	.experience__timeline::after {
		content: '';
		position: absolute;
		left: 50%;
		width: 14px;
		height: 14px;
		border-radius: 50%;
		background-color: var(--orange);
		border: 1px solid var(--border);
		transform: translateX(-50%);
	}

	.experience__timeline::before {
		top: -6px;
	}

	.experience__timeline::after {
		bottom: -6px;
	}

	.languages__list {
		width: 50%;
		margin-top: 16px;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.languages__legend {
		display: flex;
		align-items: center;
		gap: 16px;
		margin-top: 8px;
	}

	.legend__indicator {
		display: flex;
		align-items: center;
		gap: 6px;
	}

	.legend__dot {
		width: 12px;
		height: 12px;
		border-radius: 50%;
	}

	.stack__section {
		margin-top: 14px;
		max-width: 600px;
	}

	.stack__section + .stack__section {
		margin-top: 36px;
	}

	.stack__list {
		margin-top: 16px;
		display: flex;
		flex-wrap: wrap;
		flex-direction: row;
		justify-content: center;
		gap: 12px;
	}

	.projects__container {
		width: 100%;
		max-width: 1200px;
		margin-top: 32px;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	@media (max-width: 1024px) {
		.languages__list {
			width: calc(100% - 24px);
		}
	}

	@media (max-width: 768px) {
		.main__section {
			padding: 24px 16px;
		}

		.experience__content {
			width: 100%;
			padding-left: 0;
		}

		.experience__timeline {
			display: block;
			left: 50%;
			transform: translateX(-50%);
			top: 8px !important;
			bottom: 8px;
			height: auto !important;
			width: 3px;
			background-color: var(--border);
		}
	}
</style>

<script type="module">
// Measure marker centers and set timeline top/height to span from first to last marker
function updateTimeline() {
	const container = document.querySelector('.experience__content');
	if (!container) return;
	
	const timeline = container.querySelector('.experience__timeline');
	const markers = container.querySelectorAll('.experience__card__marker');
	if (!timeline) return;

	if (window.matchMedia('(max-width: 768px)').matches) {
		timeline.style.top = '0px';
		timeline.style.height = '100%';
		return;
	}

	if (markers.length === 0) return;

	const parentRect = container.getBoundingClientRect();
	const centers = Array.from(markers).map(m => {
		const r = m.getBoundingClientRect();
		return r.top + r.height / 2 - parentRect.top;
	});

	const min = Math.min(...centers);
	const max = Math.max(...centers);
	timeline.style.top = Math.round(min) + 'px';
	timeline.style.height = Math.max(2, Math.round(max - min)) + 'px';
}

window.addEventListener('load', () => {
	updateTimeline();
	window.addEventListener('resize', updateTimeline);
	// observe content changes
	const container = document.querySelector('.experience__content');
	if (container && window.ResizeObserver) {
		const ro = new ResizeObserver(updateTimeline);
		ro.observe(container);
		container.querySelectorAll('.experience__card').forEach(c => ro.observe(c));
	}
});
</script>
